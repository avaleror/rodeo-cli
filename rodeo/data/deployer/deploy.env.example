# Copy this file to deploy.env and edit it, then run: sudo ./deploy.sh
# deploy.env is gitignored because it holds passwords. Never commit it.

# --- Network model ---
# nat    : self-contained single host. Guests sit on libvirt's 192.168.122.0/24
#          NAT network; the host DNATs the UI ports to the guests. Works anywhere.
# bridge : guests attach to an existing host bridge and get real LAN IPs.
#          The bridge ($HOST_BRIDGE) must already exist (nmcli / Cockpit).
#          Also copy deploy.vars.yml.example -> deploy.vars.yml and set per-node
#          IPs + gateway to match your LAN.
NETWORK_MODE=nat
HOST_BRIDGE=br0

# --- Addresses ---
# HARVESTER_VIP is the floating kube-vip VIP. It MUST be a free address, NOT a
# node IP (nodes are .11/.12/.13, rancher .9) — it migrates to a surviving node
# when one goes down. nat mode: leave as-is. bridge mode: set both to free LAN
# addresses (and edit deploy.vars.yml for the per-node IPs + gateway).
HARVESTER_VIP=192.168.122.10
RANCHER_IP=192.168.122.9

# --- Component versions (keep in sync with the Ansible defaults) ---
RANCHER_VERSION=2.13.1
K3S_VERSION=v1.31.4+k3s1

# --- Credentials ---
# Node OS / VM console passwords baked into the seed ISOs + cloud-init.
HARVESTER_OS_PASSWORD=Foobar12345$
RANCHER_VM_PASSWORD=Foobar12345$
# Fixed admin password for the Rancher AND Harvester dashboards/APIs (predictable
# for scripting). Lab-grade only — do not reuse anywhere real.
LAB_ADMIN_PASSWORD=Foobar12345$

# --- Behaviour ---
# true: stop once the 3-node Harvester cluster is up (skip K3s + Rancher).
SKIP_RANCHER=false

# Ansible inventory. Default targets the local host (inventory.local).
# Point this at your own inventory file to drive a remote host instead.
# ANSIBLE_INVENTORY=/path/to/inventory.ini
