#!ipxe
# Auto-generated by Ansible pxe_server role — do not edit by hand.
#
# Generic stage-2 script served to every iPXE client (dnsmasq dhcp-boot tag:ipxe).
# It chains to the per-node script chosen by the management NIC's MAC, e.g.
# ipxe/mac-02-00-00-0d-62-e1. net0 is the mgmt NIC (first <interface> in the VM
# XML, and the one that PXE-booted). This replaces per-host dnsmasq tags, which
# do not work once libvirt manages the node IP via a <host mac=.../> entry.
chain http://{{ pxe_http_bind }}:{{ pxe_http_port }}/ipxe/mac-${net0/mac:hexhyp}
