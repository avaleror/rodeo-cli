{% set first_harvester = vm_nodes | selectattr('flavor', 'equalto', 'harvester') | first %}
# Auto-generated by Ansible pxe_server role — do not edit by hand.
# Node: {{ item.name }} | Mode: {{ 'create' if item.name == first_harvester.name else 'join' }}
scheme_version: 1

{% if item.name == first_harvester.name %}
server_url: ""
{% else %}
server_url: "https://{{ harvester_vip }}:443"
{% endif %}

token: "{{ harvester_token }}"

os:
  hostname: {{ item.name }}
  password: "{{ harvester_os_password }}"
  ssh_authorized_keys:
    - "{{ ssh_public_key }}"
  ntp_servers:
    - 0.pool.ntp.org
    - 1.pool.ntp.org
  dns_nameservers:
    - 8.8.8.8
    - 1.1.1.1

install:
{% if item.name == first_harvester.name %}
  mode: create
{% else %}
  mode: join
{% endif %}
  management_interface:
    interfaces:
      - name: eth0
    method: static
    ip: {{ item.ip }}
    subnet_mask: {{ node_subnet_mask }}
    gateway: {{ libvirt_network_gateway }}
{% if item.name == first_harvester.name %}
  vip: {{ harvester_vip }}
  vip_mode: static
{% endif %}
  device: /dev/vda
  tty: ttyS0,115200n8
  iso_url: "http://{{ pxe_http_bind }}:{{ pxe_http_port }}/harvester/harvester-v{{ harvester_version }}-amd64.iso"
  poweroff: false
