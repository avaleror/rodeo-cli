<!-- Auto-generated by Ansible pxe_server role. Extends the vms role network.xml.j2
     with the dnsmasq namespace required for two-stage iPXE PXE boot. -->
<network xmlns:dnsmasq='http://libvirt.org/schemas/network/dnsmasq/1.0'>
  <name>default</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='virbr0' stp='on' delay='0'/>
  <!-- {{ lab_dns_domain }} served locally by libvirt's built-in dnsmasq on virbr0 -->
  <domain name='{{ lab_dns_domain }}' localOnly='yes'/>
  <dns>
    <!-- Harvester floating VIP — cluster API + UI -->
    <host ip='{{ harvester_vip }}'>
      <hostname>virtualization.{{ lab_dns_domain }}</hostname>
    </host>
{% for node in vm_nodes %}
    <host ip='{{ node.ip }}'>
      <hostname>{{ node.hostname }}.{{ lab_dns_domain }}</hostname>
    </host>
{% endfor %}
  </dns>
  <ip address='{{ libvirt_network_gateway }}' netmask='255.255.255.0'>
    <dhcp>
      <range start='192.168.122.100' end='192.168.122.254'/>
{% for node in vm_nodes %}
      <host mac='{{ node.mgmt_mac }}' name='{{ node.name }}' ip='{{ node.ip }}'/>
{% endfor %}
    </dhcp>
  </ip>
  <dnsmasq:options>
    <!-- TFTP: serve ipxe.efi from pxe_tftp_root for UEFI stage-1 boot -->
    <dnsmasq:option value='enable-tftp'/>
    <dnsmasq:option value='tftp-root={{ pxe_tftp_root }}'/>

    <!-- Detect iPXE stage-2: iPXE sends user-class "iPXE" in its DHCP request -->
    <dnsmasq:option value='dhcp-userclass=set:ipxe,iPXE'/>

    <!-- Stage 1: UEFI (no iPXE user-class) → serve ipxe.efi via TFTP.
         tag:!ipxe means "this host has NOT been tagged ipxe", i.e. a plain
         UEFI request. Without this distinction iPXE would enter an infinite
         reload loop (stage-1 and stage-2 would both receive ipxe.efi). -->
    <dnsmasq:option value='dhcp-boot=tag:!ipxe,ipxe.efi'/>

    <!-- Stage 2: any iPXE client → one generic boot script that chains to the
         per-node script selected by the mgmt NIC's MAC (ipxe/mac-${net0/mac}).
         We deliberately do NOT use per-host dnsmasq tags: libvirt already writes
         a <host mac=.../> dhcp-host for each node's IP, and a SECOND dhcp-host for
         the same MAC (to set a tag) is silently ignored by dnsmasq — so the
         per-node tag never applied and iPXE received no boot file. The MAC-based
         chain sidesteps that conflict entirely. -->
    <dnsmasq:option value='dhcp-boot=tag:ipxe,http://{{ pxe_http_bind }}:{{ pxe_http_port }}/ipxe/boot.ipxe'/>
  </dnsmasq:options>
</network>
