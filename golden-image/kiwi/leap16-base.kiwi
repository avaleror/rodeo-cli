<?xml version="1.0" encoding="utf-8"?>
<!--
  Golden host base image for rodeo-cli labs (KIWI NG).

  Validated build: KIWI 10.2.33 on SLES 16 produced a bootable cloud-init
  qcow2 from the public Leap 16 OSS repo in ~2.5 minutes, no subscription.
  This is the Layer 1 base (see ../README.md). Layer 2 (rodeo + the Harvester
  ISO and base images) is added at first boot via cloud-init, NOT baked here.

  Build:
    kiwi-ng system build --description golden-image/kiwi \
      --target-dir /var/tmp/rodeo-golden-out

  Other cloud formats: change the type "format" to gce (GCP), vhdfixed (Azure),
  vmdk/ova (VMware). AWS has no one-shot format: build raw, then import-snapshot
  and register the AMI.
-->
<image schemaversion="8.3" name="RodeoGoldenBase">
  <description type="system">
    <author>rodeo</author>
    <contact>rodeo@suse.com</contact>
    <specification>rodeo golden host base (Leap 16, cloud-init)</specification>
  </description>
  <preferences>
    <version>0.1.0</version>
    <packagemanager>zypper</packagemanager>
    <locale>en_US</locale>
    <keytable>us</keytable>
    <timezone>UTC</timezone>
    <type image="oem" filesystem="ext4" firmware="uefi" format="qcow2" kernelcmdline="console=ttyS0 net.ifnames=0">
      <oemconfig>
        <oem-resize>false</oem-resize>
        <oem-swap>false</oem-swap>
      </oemconfig>
    </type>
  </preferences>
  <users>
    <user password="rodeo" pwdformat="plain" home="/root" name="root" groups="root"/>
  </users>
  <repository type="rpm-md">
    <source path="http://download.opensuse.org/distribution/leap/16.0/repo/oss/"/>
  </repository>
  <packages type="image">
    <package name="patterns-base-minimal_base"/>
    <package name="kernel-default"/>
    <package name="dracut"/>
    <package name="grub2"/>
    <package name="grub2-x86_64-efi"/>
    <package name="shim"/>
    <package name="systemd"/>
    <package name="zypper"/>
    <package name="cloud-init"/>
    <package name="openssh"/>
  </packages>
  <packages type="bootstrap">
    <package name="filesystem"/>
    <package name="glibc-locale-base"/>
    <package name="ca-certificates-mozilla"/>
  </packages>
</image>
