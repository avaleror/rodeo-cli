#!ipxe
# Auto-generated by Ansible pxe_server role — do not edit by hand.
# Node: {{ item.name }} ({{ item.ip }})
# Mode: {% set first_harvester = vm_nodes | selectattr('flavor', 'equalto', 'harvester') | first %}
{%- if item.name == first_harvester.name %}CREATE (bootstrap cluster){% else %}JOIN ({{ harvester_vip }}){% endif %}

# dhcp must be the first command — iPXE has its own network stack that must be
# initialised independently from the UEFI firmware. Without it, all HTTP
# downloads fail with "Network unreachable".
dhcp

kernel http://{{ pxe_http_bind }}:{{ pxe_http_port }}/harvester/harvester-v{{ harvester_version }}-vmlinuz-amd64 \
  initrd=harvester-v{{ harvester_version }}-initrd-amd64 \
  ip=dhcp \
  rd.net.dhcp.retry=30 \
  rd.cos.disable \
  rd.noverifyssl \
  net.ifnames=1 \
  root=live:http://{{ pxe_http_bind }}:{{ pxe_http_port }}/harvester/harvester-v{{ harvester_version }}-rootfs-amd64.squashfs \
  console=ttyS0,115200n8 \
  harvester.install.automatic=true \
  harvester.install.skipchecks=true \
  harvester.install.config_url=http://{{ pxe_http_bind }}:{{ pxe_http_port }}/config/config-{{ item.name }}.yaml
initrd http://{{ pxe_http_bind }}:{{ pxe_http_port }}/harvester/harvester-v{{ harvester_version }}-initrd-amd64
boot
