---
# Optional Ansible overrides for the agnostic deployer.
# Copy to deploy.vars.yml and edit. Only needed for bridge networking or when
# you want non-default per-node addresses. For plain NAT mode you can ignore it.
#
# deploy.sh reads this file first, THEN applies deploy.env. So deploy.env stays
# authoritative for network_mode / host_bridge / harvester_vip / rancher_ip /
# passwords — do NOT set those here. This file supplies only what deploy.env does
# not carry: the LAN gateway and the per-node address list.
#
# Keep these consistent with deploy.env: HARVESTER_VIP must be a free address that
# is NOT in this node list (the floating kube-vip VIP), rancher's ip should equal
# RANCHER_IP, and everything sits on the same subnet as the gateway. For example
# with this 192.168.1.0/24 LAN: nodes .11/.12/.13, rancher .9, HARVESTER_VIP=.10.

# Gateway on your physical LAN (bridge mode). For a non-/24 LAN also override
# node_subnet_mask and node_prefix.
libvirt_network_gateway: "192.168.1.1"
# node_subnet_mask: "255.255.255.0"
# node_prefix: 24

# Per-node addresses on the LAN. Keep the MACs/UUIDs unless you have a reason
# to change them — stable MACs keep DHCP/etcd happy across reboots.
vm_nodes:
  - name: harvester1
    flavor: harvester
    hostname: alpha
    uuid: "1c5e1f38-1fb8-4f03-9eaa-12838f70faa1"
    mgmt_mac: "02:00:00:0D:62:E1"
    storage_mac: "02:00:00:0D:63:E1"
    migration_mac: "02:00:00:0D:64:E1"
    service1_mac: "02:00:00:0D:65:E1"
    service2_mac: "02:00:00:0D:66:E1"
    ip: "192.168.1.11"
    config_iso_name: "harvester-config-node1"
  - name: harvester2
    flavor: harvester
    hostname: bravo
    uuid: "4e156918-3e00-44c2-bf47-0b532b3807c1"
    mgmt_mac: "02:00:00:0D:62:E2"
    storage_mac: "02:00:00:0D:63:E2"
    migration_mac: "02:00:00:0D:64:E2"
    service1_mac: "02:00:00:0D:65:E2"
    service2_mac: "02:00:00:0D:66:E2"
    ip: "192.168.1.12"
    config_iso_name: "harvester-config-node2"
  - name: harvester3
    flavor: harvester
    hostname: charlie
    uuid: "4541177c-c6b7-4ab3-b418-e2a0b17beb9d"
    mgmt_mac: "02:00:00:0D:62:E3"
    storage_mac: "02:00:00:0D:63:E3"
    migration_mac: "02:00:00:0D:64:E3"
    service1_mac: "02:00:00:0D:65:E3"
    service2_mac: "02:00:00:0D:66:E3"
    ip: "192.168.1.13"
    config_iso_name: "harvester-config-node3"
  - name: rancher
    flavor: rancher
    hostname: rancher
    uuid: "77994fd6-7ebb-4ad3-baf4-55575b0ce265"
    mgmt_mac: "02:00:00:0D:62:E9"
    ip: "192.168.1.9"
    config_iso_name: ""
